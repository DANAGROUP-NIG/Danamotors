{
  "name": "danamotors_backend",
  "version": "1.0.0",
  "description": "Dana Motors service backend",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests configured yet\" && exit 0",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed/index.ts",
    "prisma:seed:branches": "ts-node prisma/seed/branches.ts",
    "prisma:seed:roles": "ts-node prisma/seed/roles.ts",
    "prisma:seed:staff": "ts-node prisma/seed/staff.ts",
    "prisma:seed:services": "ts-node prisma/seed/services.ts",
    "prisma:seed:spare-parts": "ts-node prisma/seed/spareParts.ts",
    "prisma:seed:inventory": "ts-node prisma/seed/inventory.ts",
    "prisma:seed:transactions": "ts-node prisma/seed/transactions.ts",
    "prisma:seed:portal": "ts-node prisma/seed/portal.ts",
    "prisma:seed:enquiries": "ts-node prisma/seed/enquiries.ts"
  },
  "author": "buildwithzeke <ayeoluwaseyi@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "6.16.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^6.4.15",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.2",
    "prisma": "6.16.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
