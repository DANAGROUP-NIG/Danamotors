// A warranty claim, from the job card to manufacturer settlement.
model WarrantyCase {
  id         String @id @default(uuid())
  caseNumber String @unique

  // One case per job card, so the automatic open is idempotent.
  jobCardId String?  @unique
  jobCard   JobCard? @relation(fields: [jobCardId], references: [id], onDelete: SetNull)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  status              WarrantyCaseStatus @default(OPEN)
  openedAutomatically Boolean            @default(false)

  complaintCodeId String?
  complaintCode   WarrantyComplaintCode? @relation(fields: [complaintCodeId], references: [id], onDelete: SetNull)
  complaint       String?

  // Mileage and coverage when the case was opened.
  mileage        Int?
  coverageStatus WarrantyCoverageStatus?

  manufacturerClaimNo   String?
  manufacturerClaimDate DateTime?
  submittedAt           DateTime?
  decisionAt            DateTime?

  rejectReasonId String?
  rejectReason   WarrantyRejectReason? @relation(fields: [rejectReasonId], references: [id], onDelete: SetNull)

  claimedAmount  Float  @default(0)
  approvedAmount Float?

  settledAt     DateTime?
  settlementRef String?
  settledAmount Float?
  closedAt      DateTime?

  assignedOfficerId String?
  assignedOfficer   User?   @relation("WarrantyCaseOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("WarrantyCaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         WarrantyCaseLine[]
  statusHistory WarrantyCaseStatusHistory[]

  @@index([branchId, status])
  @@index([status, createdAt])
  @@index([vehicleId])
  @@index([manufacturerClaimNo])
}

model WarrantyCaseLine {
  id String @id @default(uuid())

  caseId String
  case   WarrantyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  seq  Int
  kind JobCardLineKind
  // Parts only: the failed (causal) part or a part damaged as a result (consequential).
  role WarrantyLineRole?

  sparePartId String?
  sparePart   SparePart? @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  partNumber    String?
  operationCode String?
  description   String

  defectCodeId String?
  defectCode   WarrantyDefectCode? @relation(fields: [defectCodeId], references: [id], onDelete: SetNull)

  positionCodeId String?
  positionCode   WarrantyPositionCode? @relation(fields: [positionCodeId], references: [id], onDelete: SetNull)

  batchNo String?

  // Quantity for parts, hours for labour.
  quantity        Float
  rate            Float
  claimedAmount   Float
  approvalPercent Float  @default(100)
  approvedAmount  Float?

  jobCardLineId String?
  jobCardLine   JobCardLine? @relation(fields: [jobCardLineId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, seq])
  @@index([jobCardLineId])
}

model WarrantyCaseStatusHistory {
  id     String       @id @default(uuid())
  caseId String
  case   WarrantyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  fromStatus WarrantyCaseStatus?
  toStatus   WarrantyCaseStatus

  actorId String?
  actor   User?   @relation("WarrantyCaseStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  remarks   String?
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

// Recall, free fix or service campaign targeted by VIN.
model Campaign {
  id     String         @id @default(uuid())
  code   String         @unique
  title  String
  type   CampaignType
  status CampaignStatus @default(DRAFT)

  description       String?
  defectDescription String?

  startDate DateTime
  endDate   DateTime?

  labourCovered Boolean @default(true)
  partsCovered  Boolean @default(true)

  activatedAt DateTime?
  closedAt    DateTime?

  createdById String?
  createdBy   User?   @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models       CampaignModel[]
  coveredItems CampaignCoveredItem[]
  vehicles     CampaignVehicle[]
  jobCards     JobCardCampaign[]
  jobCardLines JobCardLine[]

  @@index([status, type])
}

model CampaignModel {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)

  yearFrom Int?
  yearTo   Int?

  @@id([campaignId, vehicleModelId])
  @@index([vehicleModelId])
}

// Part or labour covered by a campaign. `partNumber` may end in x or * to match a prefix (91200-D3xxx).
model CampaignCoveredItem {
  id String @id @default(uuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  kind          JobCardLineKind
  partNumber    String?
  operationCode String?
  description   String
  maxQuantity   Float?

  createdAt DateTime @default(now())

  @@index([campaignId])
}

// An affected vehicle. Keyed by VIN so manufacturer lists can include vehicles not yet in the system.
model CampaignVehicle {
  id String @id @default(uuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  vin       String
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  status CampaignVehicleStatus @default(PENDING)

  contactAttempts    Int             @default(0)
  lastContactAt      DateTime?
  lastContactOutcome ContactOutcome?
  nextFollowUpAt     DateTime?

  contactedAt DateTime?
  scheduledAt DateTime?
  completedAt DateTime?

  appointmentId String?
  appointment   ServiceAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  completedJobCardId String?
  completedJobCard   JobCard? @relation("CampaignVehicleCompletedBy", fields: [completedJobCardId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactLogs CampaignContactLog[]

  @@unique([campaignId, vin])
  @@index([vehicleId])
  @@index([vin])
  @@index([campaignId, status])
}

model CampaignContactLog {
  id String @id @default(uuid())

  campaignVehicleId String
  campaignVehicle   CampaignVehicle @relation(fields: [campaignVehicleId], references: [id], onDelete: Cascade)

  channel        ContactChannel
  outcome        ContactOutcome
  notes          String?
  nextFollowUpAt DateTime?

  actorId String?
  actor   User?   @relation("CampaignContactActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([campaignVehicleId, createdAt])
}

// Campaigns a job card was opened for, snapshotted at creation.
model JobCardCampaign {
  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  campaignCode  String
  campaignTitle String
  campaignType  CampaignType

  createdAt DateTime @default(now())

  @@id([jobCardId, campaignId])
  @@index([campaignId])
}

model FinanceSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model PartyNoteReceiptLine {
  id String @id @default(uuid())
  noteId String
  note PartyNote @relation(fields:[noteId],references:[id],onDelete:Restrict)
  receiptId String
  receipt Receipt @relation(fields:[receiptId],references:[id],onDelete:Restrict)
  position Int
  amount Decimal @db.Decimal(18,2)
  receiptNumber String
  receiptDate DateTime
  chequeNumber String?
  receiptAmount Decimal @db.Decimal(18,2)
  narration String
  @@unique([noteId,receiptId])
  @@unique([noteId,position])
  @@index([receiptId])
}
model PartyNoteAccountLine {
  id String @id @default(uuid())
  noteId String
  note PartyNote @relation(fields:[noteId],references:[id],onDelete:Restrict)
  ledgerId String
  ledger TallyLedger @relation(fields:[ledgerId],references:[id],onDelete:Restrict)
  position Int
  accountCode String
  accountName String
  narration String
  amount Decimal @db.Decimal(18,2)
  @@unique([noteId,position])
  @@index([ledgerId])
}
