  tallyPostedAt   DateTime?
  tallyPostedById String?
  tallyPostedBy   User?     @relation("ReceiptTallyPostedBy", fields: [tallyPostedById], references: [id], onDelete: SetNull)

  issuedAt DateTime @default(now())

  reference String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations ReceiptAllocation[]
  editLogs    ReceiptEditLog[]
  payments    Payment[]           @relation("PaymentReceiptLink")

  @@index([invoiceId])
  @@index([customerId, issuedAt])
  @@index([issuedById])
