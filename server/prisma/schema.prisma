generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id          String   @id @default(uuid())
  name        String   @unique
  // Legacy store-location code (e.g. A, QS, DH, VI).
  code        String?  @unique
  // Set when this is a sub-location (store, godown) at another branch's premises.
  parentBranchId String?
  parentBranch   Branch?  @relation("BranchSubLocations", fields: [parentBranchId], references: [id], onDelete: SetNull)
  subLocations   Branch[] @relation("BranchSubLocations")
  address     String?
  city        String?
  state       String?
  country     String?
  phoneNumber String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  customers         Customer[]
  jobCards          JobCard[]
  appointments      ServiceAppointment[]
  enquiries         Enquiry[]
  inventoryStocks   InventoryStock[]
  partIssuances     PartIssuance[]
  stockTransactions StockTransaction[]

  transferRequests InterBranchTransfer[] @relation("RequestingBranch")
  transferSources  InterBranchTransfer[] @relation("SourceBranch")

  indentRequests BranchIndent[]      @relation("IndentRequestingBranch")
  indentSources  BranchIndent[]      @relation("IndentSourceBranch")
  pickingLists   PickingList[]       @relation("PickingListBranch")
  stnsOut        StockTransferNote[] @relation("StnSourceBranch")
  stnsIn         StockTransferNote[] @relation("StnDestinationBranch")
  transferCases  TransferCase[]      @relation("TransferCaseBranch")
  packingLists   PackingList[]       @relation("PackingListBranch")
  mitsOut        MaterialInTransit[] @relation("MitSourceBranch")
  mitsIn         MaterialInTransit[] @relation("MitDestinationBranch")
  srnsReceived   StockReceiptNote[]  @relation("SrnReceivingBranch")
  mrnsReceived   MaterialReceiptNote[] @relation("MrnReceivingBranch")
  srnsSourced    StockReceiptNote[]  @relation("SrnSourceBranch")

  notifications Notification[]
}

// ============================================================
// USER / AUTH
// ============================================================

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phoneNumber  String?
  isActive     Boolean @default(true)

  resetTokenHash   String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdAppointments ServiceAppointment[]   @relation("ReceptionistBookings")
  createdCustomers    Customer[]             @relation("CreatedCustomers")
  createdVehicles     Vehicle[]              @relation("CreatedVehicles")
  advisedJobs         JobCard[]              @relation("JobServiceAdvisor")
  deliveredJobs       JobCard[]              @relation("JobDeliveryAdvisor")
  creditApprovedJobs  JobCard[]              @relation("JobCreditApprover")
  jobStatusChanges    JobCardStatusHistory[]
  createdJobCards     JobCard[]              @relation("CreatedJobCards")

  technicianAssignments       JobCard[] @relation("TechnicianAssignments")
  qualityInspectorAssignments JobCard[] @relation("QualityInspectorAssignments")

  purchaseRequests PurchaseRequest[] @relation("UserPurchaseRequests")

  issuedPartIssuances PartIssuance[] @relation("UserPartIssuances")
  returnedPartReturns PartReturn[]   @relation("UserPartReturns")

  recordedPayments       Payment[]         @relation("UserRecordedPayments")
  issuedReceipts         Receipt[]         @relation("UserIssuedReceipts")
  jobCardLabourLines     JobCardLabour[]
  serviceAdvisorInvoices Invoice[]         @relation("InvoiceServiceAdvisor")
  cancelledInvoices      Invoice[]         @relation("InvoiceCancelledBy")
  tallyPostedInvoices    Invoice[]         @relation("InvoiceTallyPostedBy")
  tallyPostedReceipts    Receipt[]         @relation("ReceiptTallyPostedBy")
  receiptEditLogs        ReceiptEditLog[]
  tallyPostingLogs       TallyPostingLog[] @relation("TallyPostingUser")

  transferRequests   InterBranchTransfer[] @relation("TransferRequestedBy")
  transferApprovals  InterBranchTransfer[] @relation("TransferApprovedBy")
  transferDispatches InterBranchTransfer[] @relation("TransferDispatchedBy")
  transferReceives   InterBranchTransfer[] @relation("TransferReceivedBy")

  indentsRequested     BranchIndent[]          @relation("IndentRequestedBy")
  indentsApproved      BranchIndent[]          @relation("IndentApprovedBy")
  indentsRejected      BranchIndent[]          @relation("IndentRejectedBy")
  indentsCancelled     BranchIndent[]          @relation("IndentCancelledBy")
  transferStatusEvents TransferStatusHistory[] @relation("TransferStatusActor")
  pickingListsCreated  PickingList[]           @relation("PickingListCreatedBy")
  pickingListsDone     PickingList[]           @relation("PickingListCompletedBy")
  stnsCreated          StockTransferNote[]     @relation("StnCreatedBy")
  stnsDispatched       StockTransferNote[]     @relation("StnDispatchedBy")
  transferCasesCreated TransferCase[]          @relation("TransferCaseCreatedBy")
  packingListsCreated  PackingList[]           @relation("PackingListCreatedBy")
  mitsCreated          MaterialInTransit[]     @relation("MitCreatedBy")
  srnsReceived         StockReceiptNote[]      @relation("SrnReceivedBy")
  mrnsReceived         MaterialReceiptNote[]   @relation("MrnReceivedBy")

  recordedStockTransactions StockTransaction[] @relation("UserStockTransactions")

  notifications Notification[]

  creditTransactions CustomerCreditTransaction[] @relation("UserCreditTransactions")
  creditRequests     CustomerCreditApplication[] @relation("AdvisorCreditRequests")

  reviewedEnquiries Enquiry[] @relation("EnquiryReviewedBy")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id                     String    @id @default(uuid())
  firstName              String
  lastName               String
  email                  String?   @unique
  phoneNumber            String?
  dateOfBirth            DateTime?
  driverLicenseNumber    String?
  address                String?
  city                   String?
  state                  String?
  postalCode             String?
  country                String?
  residencePhone         String?
  fax                    String?
  stdCode                String?
  vip                    Boolean @default(false)
  anniversaryDate        String?
  preferredFollowupDay   String?
  preferredFollowupTime  String?
  preferredContactMethod String?

  code           String? @unique
  type           String  @default("INDIVIDUAL")
  salutation     String?
  companyName    String?
  contactPerson  String?
  registeredName String?
  mobile2        String?
  office1        String?
  office2        String?
  house          String?
  street         String?
  zone           String?
  tallyPartyCode String?
  mergedIntoId   String?

  creditBalance Float @default(0)

  branchId    String
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User?  @relation("CreatedCustomers", fields: [createdById], references: [id], onDelete: SetNull)

  account           CustomerAccount?
  documents         CustomerDocument[]
  serviceHistory    ServiceHistory[]
  vehicles          Vehicle[]
  vehicleOwnerships VehicleOwnership[]
  appointments      ServiceAppointment[]
  jobCards          JobCard[]
  approvals         CustomerApproval[]
  invoices          Invoice[]
  receipts          Receipt[]
  tallyLedgerId     String?
  tallyLedger       TallyLedger?         @relation(fields: [tallyLedgerId], references: [id], onDelete: SetNull)

  creditTransactions CustomerCreditTransaction[]
  creditApplications CustomerCreditApplication[]

  @@index([branchId])
  @@index([phoneNumber])
  @@index([mergedIntoId])
}

model CustomerAccount {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  passwordHash     String
  isActive         Boolean   @default(true)
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens CustomerRefreshToken[]
}

model CustomerRefreshToken {
  id                String          @id @default(uuid())
  token             String          @unique
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([customerAccountId])
}

// ============================================================
// SERVICE / APPOINTMENT
// ============================================================

model Service {
  id           String  @id @default(uuid())
  name         String  @unique
  description  String?
  category     String?
  durationMins Int?
  price        Float   @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments ServiceAppointment[]
}

model ServiceAppointment {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ReceptionistBookings", fields: [createdById], references: [id], onDelete: SetNull)

  scheduledAt  DateTime
  durationMins Int?
  notes        String?

  status String @default("Pending")
  source String @default("WalkIn")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCards JobCard[]
  enquiry  Enquiry?

  @@index([serviceId])
  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
}

// ============================================================
// JOB CARD
// ============================================================

model JobCard {
  id String @id @default(uuid())

  appointmentId String?
  appointment   ServiceAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  serviceTypeId      String?
  serviceType        WorkshopMaster?        @relation("JobServiceType", fields: [serviceTypeId], references: [id], onDelete: Restrict)
  bayId              String?
  bay                WorkshopMaster?        @relation("JobBay", fields: [bayId], references: [id], onDelete: Restrict)
  teamId             String?
  team               WorkshopMaster?        @relation("JobTeam", fields: [teamId], references: [id], onDelete: Restrict)
  serviceAdvisorId   String?
  serviceAdvisor     User?                  @relation("JobServiceAdvisor", fields: [serviceAdvisorId], references: [id], onDelete: Restrict)
  deliveryAdvisorId  String?
  deliveryAdvisor    User?                  @relation("JobDeliveryAdvisor", fields: [deliveryAdvisorId], references: [id], onDelete: Restrict)
  mileage            Int?
  promisedAt         DateTime?
  acFitted           Boolean                @default(false)
  inHouse            Boolean                @default(true)
  remarks            String?
  observations       String?
  workDone           String?
  isRepeat           Boolean                @default(false)
  previousJobId      String?
  previousJob        JobCard?               @relation("RepeatJob", fields: [previousJobId], references: [id], onDelete: Restrict)
  repeatJobs         JobCard[]              @relation("RepeatJob")
  repeatReason       String?
  readyAt            DateTime?
  deliveredAt        DateTime?
  gatePassNumber     String?                @unique
  lateReasonIds      String[]               @default([])
  creditApprovedById String?
  creditApprovedBy   User?                  @relation("JobCreditApprover", fields: [creditApprovedById], references: [id], onDelete: Restrict)
  complaints         JobComplaint[]
  statusHistory      JobCardStatusHistory[]

  jobNumber   String @unique
  description String

  status         String @default("Open")
  estimatedHours Float?
  tyres          Json?
  batteryMake    String?
  batteryNumber  String?
  customField1   String?
  acType         String?
  checklist      String?
  estimatedParts Float?
  estimatedOil   Float?
  estimatedLabour Float?
  serviceCharge  Float?
  estimatedCost  Float?

  assignedTo String?
  progress   Int?    @default(0)

  qcStatus String? @default("Pending")
  qcNotes  String?

  qualityInspectorId String?
  qualityInspector   User?   @relation("QualityInspectorAssignments", fields: [qualityInspectorId], references: [id], onDelete: SetNull)

  technicianId String?
  technician   User?   @relation("TechnicianAssignments", fields: [technicianId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("CreatedJobCards", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections   Inspection[]
  estimates     Estimate[]
  partIssuances PartIssuance[]
  invoices      Invoice[]
  labourLines   JobCardLabour[]
  billedAt      DateTime?

  indentLines   BranchIndentLine[] @relation("IndentLineJobCard")

  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([vehicleId, createdAt])
  @@index([appointmentId])
}

// ============================================================
// INSPECTION
// ============================================================

model Inspection {
  id String @id @default(uuid())

  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  inspectorId String?

  findings String
  passed   Boolean?
  status   String   @default("Pending")
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobCardId])
}

// ============================================================
// ESTIMATE / APPROVAL
// ============================================================

model Estimate {
  id String @id @default(uuid())

  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  description String
  amount      Float
  currency    String @default("USD")
  status      String @default("Pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     EstimateLine[]
  approvals CustomerApproval[]

  @@index([jobCardId])
}

model CustomerApproval {
  id String @id @default(uuid())

  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  approved     Boolean?
  decisionDate DateTime?
  comments     String?
  status       String    @default("Pending")

  createdAt DateTime @default(now())

  @@index([estimateId])
  @@index([customerId])
}

// ============================================================
// VEHICLE
// ============================================================

model Vehicle {
  modelId             String?
  catalogModel        VehicleCatalogModel? @relation(fields: [modelId], references: [id], onDelete: Restrict)
  generationId        String?
  catalogGeneration   VehicleCatalogGeneration? @relation(fields: [generationId], references: [id], onDelete: Restrict)
  engineId            String?
  catalogEngine       VehicleCatalogEngine? @relation(fields: [engineId], references: [id], onDelete: Restrict)
  customMake          String?
  customModel         String?
  id String @id @default(uuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  vin                String  @unique
  registrationNumber String? @unique

  catalogueId         String?
  catalogue           WorkshopMaster? @relation("VehicleCatalogue", fields: [catalogueId], references: [id], onDelete: Restrict)
  colourId            String?
  colour              WorkshopMaster? @relation("VehicleColour", fields: [colourId], references: [id], onDelete: Restrict)
  engineNumber        String?
  keyNumber           String?
  pdiDone             Boolean         @default(false)
  pdiDate             DateTime?
  saleDate            DateTime?
  sellingDealer       String?
  lastRecordedMileage Int?
  make                String?
  model               String?
  year                Int?
  trim                String?
  color               String?

  warrantyProvider  String?
  warrantyStatus    String?
  warrantyExpiresAt DateTime?

  ownershipStatus String?

  createdById String?
  createdBy   User?   @relation("CreatedVehicles", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       VehicleImage[]
  ownerships   VehicleOwnership[]
  appointments ServiceAppointment[]
  jobCards     JobCard[]

  @@index([customerId])
  @@index([modelId])
  @@index([generationId])
  @@index([engineId])

}

model VehicleImage {
  id String @id @default(uuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url      String
  type     String?
  metadata Json?

  uploadedAt DateTime @default(now())

  @@index([vehicleId])
}

// ============================================================
enum PartStatus {
  ACTIVE
  BLOCKED
}

enum PartRole {
  MAIN
  ALTERNATE
}

// SPARE PART MASTER
// ============================================================

model SparePart {
  id String @id @default(uuid())

  partCode    String  @unique @default(uuid())
  partNumber  String  @unique
  name        String
  // `unitPrice` is the legacy column name; it maps to Part Master `unitRate`.
  description String?
  category    String?

  uom         String  @default("UNIT")
  taxCategory String?
  taxForm     String?
  minLevel    Float?
  maxLevel    Float?
  reorderQty  Float?

  unitPrice Float @default(0)
  // Legacy dealer rate is unitPrice; retail rate is the selling price.
  retailRate Float?
  // Legacy tax status (partmast.taxable).
  taxable    Boolean @default(true)
  // Legacy part flag, for example O for original.
  partFlag   String  @default("O")
  // Legacy pricing category (A, C, E…). Its multiplier derives the retail rate.
  priceCategoryCode String?
  priceCategory     PartCategory? @relation(fields: [priceCategoryCode], references: [code], onDelete: SetNull)

  binLocation   String?
  storeLocation String?
  partStatus    PartStatus @default(ACTIVE)

  // --- new: main/alternate relationship ---
  role           PartRole    @default(MAIN)
  mainPartId     String?
  mainPart       SparePart?  @relation("PartAlternates", fields: [mainPartId], references: [id], onDelete: Restrict)
  alternateParts SparePart[] @relation("PartAlternates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseRequests  PurchaseRequest[]
  issuances         PartIssuance[]
  inventoryStocks   InventoryStock[]
  stockTransactions StockTransaction[]
  transferItems     InterBranchTransferItem[]
  invoiceLines      InvoiceLine[]

  indentLines       BranchIndentLine[]      @relation("IndentLinePart")
  pickingRequested  PickingListLine[]       @relation("PickingRequestedPart")
  pickingSupplied   PickingListLine[]       @relation("PickingSuppliedPart")
  stnRequested      StockTransferNoteLine[] @relation("StnRequestedPart")
  stnSupplied       StockTransferNoteLine[] @relation("StnSuppliedPart")
  mitLines          MaterialInTransitLine[] @relation("MitLinePart")
  mitRequestedLines MaterialInTransitLine[] @relation("MitLineRequestedPart")
  srnLines          StockReceiptLine[]      @relation("SrnLinePart")
  mrnLines          MaterialReceiptLine[]   @relation("MrnLinePart")

  @@index([mainPartId])
}

// ============================================================
// BRANCH INVENTORY
// ============================================================

model InventoryStock {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  partId String
  part   SparePart @relation(fields: [partId], references: [id], onDelete: Cascade)

  quantity         Int @default(0)
  reservedQuantity Int @default(0)

  minimumStock Int  @default(0)
  maximumStock Int?

  rackLocation String?
  // Legacy bin card reference per store location (PARTBAL.bincard).
  binCard      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, partId])
  @@index([partId])
  @@index([branchId])
}

// ============================================================
// STOCK TRANSACTION / AUDIT TRAIL
// ============================================================

model StockTransaction {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  partId String
  part   SparePart @relation(fields: [partId], references: [id], onDelete: Restrict)

  type String
  // RECEIVED
  // ISSUED
  // ADJUSTMENT
  // TRANSFER_IN
  // TRANSFER_OUT
  // RESERVED
  // UNRESERVED
  // RETURNED

  quantity Int

  referenceId String?
  notes       String?

  recordedById String?
  recordedBy   User?   @relation("UserStockTransactions", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([partId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
}

// ============================================================
// INTER-BRANCH TRANSFER
// ============================================================

model InterBranchTransfer {
  id String @id @default(uuid())

  transferNumber String @unique

  requestingBranchId String
  requestingBranch   Branch @relation("RequestingBranch", fields: [requestingBranchId], references: [id], onDelete: Restrict)

  sourceBranchId String
  sourceBranch   Branch @relation("SourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)

  requestedById String
  requestedBy   User   @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User?   @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  dispatchedById String?
  dispatchedBy   User?   @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)

  receivedById String?
  receivedBy   User?   @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  status String @default("Pending")
  // Pending
  // Approved
  // Rejected
  // Dispatched
  // InTransit
  // Received
  // Completed
  // Cancelled

  notes String?

  approvedAt   DateTime?
  dispatchedAt DateTime?
  receivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InterBranchTransferItem[]

  @@index([requestingBranchId])
  @@index([sourceBranchId])
  @@index([requestedById])
  @@index([status])
}

// ============================================================
// TRANSFER ITEMS
// ============================================================

model InterBranchTransferItem {
  id String @id @default(uuid())

  transferId String
  transfer   InterBranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  partId String
  part   SparePart @relation(fields: [partId], references: [id], onDelete: Restrict)

  requestedQuantity  Int
  dispatchedQuantity Int?
  receivedQuantity   Int?

  createdAt DateTime @default(now())

  @@index([transferId])
  @@index([partId])
}

// ============================================================
// PURCHASE REQUEST
// ============================================================

model PurchaseRequest {
  id String @id @default(uuid())

  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  requestedById String
  requestedBy   User   @relation("UserPurchaseRequests", fields: [requestedById], references: [id], onDelete: Restrict)

  quantity Int

  status String @default("Pending")

  requestDate   DateTime @default(now())
  approvalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sparePartId])
  @@index([requestedById])
  @@index([status])
}

// ============================================================
// PART ISSUANCE
// ============================================================

model PartIssuance {
  id String @id @default(uuid())

  // The branch whose inventory is being reduced
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  // The job card the part is being issued for
  jobCardId String?
  jobCard   JobCard? @relation(fields: [jobCardId], references: [id], onDelete: SetNull)

  issuedById String
  issuedBy   User   @relation("UserPartIssuances", fields: [issuedById], references: [id], onDelete: Restrict)

  quantity Int

  issuedAt DateTime @default(now())

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  returns PartReturn[]

  @@index([branchId])
  @@index([sparePartId])
  @@index([jobCardId])
