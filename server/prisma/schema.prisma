  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  jobCardId String?
  jobCard   JobCard? @relation(fields: [jobCardId], references: [id], onDelete: SetNull)

  invoiceNumber String @unique

  issuedDate DateTime  @default(now())
  dueDate    DateTime?

  subtotal Float
  tax      Float @default(0)
  total    Float

  partsTotal            Float @default(0)
  labourTotal           Float @default(0)
  partsDiscountPercent  Float @default(0)
  labourDiscountPercent Float @default(0)
  partsDiscountAmount   Float @default(0)
  labourDiscountAmount  Float @default(0)
  vatRate               Float @default(7.5)
  vatAmount             Float @default(0)
  roundOff              Float @default(0)
  outstandingAmount     Float @default(0)

  serviceAdvisorId String?
  serviceAdvisor   User?   @relation("InvoiceServiceAdvisor", fields: [serviceAdvisorId], references: [id], onDelete: SetNull)

  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelRemark  String?

  tallyVoucherNo  String?
  tallyPostedAt   DateTime?
  tallyPostedById String?
  tallyPostedBy   User?     @relation("InvoiceTallyPostedBy", fields: [tallyPostedById], references: [id], onDelete: SetNull)

  status String @default("Unpaid")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

