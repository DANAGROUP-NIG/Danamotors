generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  partyNotes             PartyNote[]
  partyAdjustmentBatches PartyAdjustmentBatch[]
  receipts Receipt[]
  id          String   @id @default(uuid())
  name        String   @unique
  // Legacy store-location code (e.g. A, QS, DH, VI).
  code           String?  @unique
  // Set when this is a sub-location (store, godown) at another branch's premises.
  parentBranchId String?
  parentBranch   Branch?  @relation("BranchSubLocations", fields: [parentBranchId], references: [id], onDelete: SetNull)
  subLocations   Branch[] @relation("BranchSubLocations")
  address        String?
  city           String?
  state          String?
  country        String?
  phoneNumber    String?
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users             User[]
  customers         Customer[]
  jobCards          JobCard[]
  appointments      ServiceAppointment[]
  enquiries         Enquiry[]
  inventoryStocks   InventoryStock[]
  partIssuances     PartIssuance[]
  stockTransactions StockTransaction[]

  transferRequests InterBranchTransfer[] @relation("RequestingBranch")
  transferSources  InterBranchTransfer[] @relation("SourceBranch")

  indentRequests BranchIndent[]        @relation("IndentRequestingBranch")
  indentSources  BranchIndent[]        @relation("IndentSourceBranch")
  pickingLists   PickingList[]         @relation("PickingListBranch")
  stnsOut        StockTransferNote[]   @relation("StnSourceBranch")
  stnsIn         StockTransferNote[]   @relation("StnDestinationBranch")
  transferCases  TransferCase[]        @relation("TransferCaseBranch")
  packingLists   PackingList[]         @relation("PackingListBranch")
  mitsIn         MaterialInTransit[]   @relation("MitDestinationBranch")
  mrnsReceived   MaterialReceiptNote[] @relation("MrnReceivingBranch")
  mrnsSourced    MaterialReceiptNote[] @relation("MrnSourceBranch")

  notifications Notification[]

  warrantyCases WarrantyCase[]
}

// ============================================================
// USER / AUTH
// ============================================================

model User {
  createdPartyNotes              PartyNote[]            @relation("PartyNoteCreator")
  partyAdjustmentBatches         PartyAdjustmentBatch[] @relation("PartyAdjustmentActor")
  reversedPartyAdjustmentBatches PartyAdjustmentBatch[] @relation("PartyAdjustmentReverser")
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phoneNumber  String?
  isActive     Boolean @default(true)

  resetTokenHash   String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdAppointments ServiceAppointment[]   @relation("ReceptionistBookings")
  createdCustomers    Customer[]             @relation("CreatedCustomers")
  createdVehicles     Vehicle[]              @relation("CreatedVehicles")
  advisedJobs         JobCard[]              @relation("JobServiceAdvisor")
  deliveredJobs       JobCard[]              @relation("JobDeliveryAdvisor")
  creditApprovedJobs  JobCard[]              @relation("JobCreditApprover")
  jobStatusChanges    JobCardStatusHistory[]
  createdJobCards     JobCard[]              @relation("CreatedJobCards")

  technicianAssignments       JobCard[] @relation("TechnicianAssignments")
  qualityInspectorAssignments JobCard[] @relation("QualityInspectorAssignments")

  purchaseRequests PurchaseRequest[] @relation("UserPurchaseRequests")

  issuedPartIssuances PartIssuance[] @relation("UserPartIssuances")
  returnedPartReturns PartReturn[]   @relation("UserPartReturns")

  recordedPayments       Payment[]         @relation("UserRecordedPayments")
  issuedReceipts         Receipt[]         @relation("UserIssuedReceipts")
  jobCardLabourLines     JobCardLabour[]
  serviceAdvisorInvoices Invoice[]         @relation("InvoiceServiceAdvisor")
  cancelledInvoices      Invoice[]         @relation("InvoiceCancelledBy")
  tallyPostedInvoices    Invoice[]         @relation("InvoiceTallyPostedBy")
  tallyPostedReceipts    Receipt[]         @relation("ReceiptTallyPostedBy")
  receiptEditLogs        ReceiptEditLog[]
  tallyPostingLogs       TallyPostingLog[] @relation("TallyPostingUser")

  transferRequests   InterBranchTransfer[] @relation("TransferRequestedBy")
  transferApprovals  InterBranchTransfer[] @relation("TransferApprovedBy")
  transferDispatches InterBranchTransfer[] @relation("TransferDispatchedBy")
  transferReceives   InterBranchTransfer[] @relation("TransferReceivedBy")

  indentsRequested     BranchIndent[]          @relation("IndentRequestedBy")
  indentsApproved      BranchIndent[]          @relation("IndentApprovedBy")
  indentsRejected      BranchIndent[]          @relation("IndentRejectedBy")
  indentsCancelled     BranchIndent[]          @relation("IndentCancelledBy")
  transferStatusEvents TransferStatusHistory[] @relation("TransferStatusActor")
  pickingListsCreated  PickingList[]           @relation("PickingListCreatedBy")
  pickingListsDone     PickingList[]           @relation("PickingListCompletedBy")
  stnsCreated          StockTransferNote[]     @relation("StnCreatedBy")
  stnsDispatched       StockTransferNote[]     @relation("StnDispatchedBy")
  transferCasesCreated TransferCase[]          @relation("TransferCaseCreatedBy")
  packingListsCreated  PackingList[]           @relation("PackingListCreatedBy")
  mitsCreated          MaterialInTransit[]     @relation("MitCreatedBy")
  mrnsReceived         MaterialReceiptNote[]   @relation("MrnReceivedBy")

  recordedStockTransactions StockTransaction[] @relation("UserStockTransactions")

  notifications Notification[]

  creditTransactions CustomerCreditTransaction[] @relation("UserCreditTransactions")
  creditRequests     CustomerCreditApplication[] @relation("AdvisorCreditRequests")

  reviewedEnquiries Enquiry[] @relation("EnquiryReviewedBy")

  warrantyAcknowledgedJobCards JobCard[]                   @relation("JobCardWarrantyAcknowledgedBy")
  jobCardLinesCreated          JobCardLine[]               @relation("JobCardLineCreatedBy")
  jobCardLineChargeChanges     JobCardLine[]               @relation("JobCardLineChargeChangedBy")
  warrantyCasesAssigned        WarrantyCase[]              @relation("WarrantyCaseOfficer")
  warrantyCasesCreated         WarrantyCase[]              @relation("WarrantyCaseCreatedBy")
  warrantyCaseStatusEvents     WarrantyCaseStatusHistory[] @relation("WarrantyCaseStatusActor")
  campaignsCreated             Campaign[]                  @relation("CampaignCreatedBy")
  campaignContactLogs          CampaignContactLog[]        @relation("CampaignContactActor")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id                     String    @id @default(uuid())
  firstName              String
  lastName               String
  email                  String?   @unique
  phoneNumber            String?
  dateOfBirth            DateTime?
  driverLicenseNumber    String?
  address                String?
  city                   String?
  state                  String?
  postalCode             String?
  country                String?
  residencePhone         String?
  fax                    String?
  stdCode                String?
  vip                    Boolean @default(false)
  anniversaryDate        String?
  preferredFollowupDay   String?
  preferredFollowupTime  String?
  preferredContactMethod String?

  code           String? @unique
  type           String  @default("INDIVIDUAL")
  salutation     String?
  companyName    String?
  contactPerson  String?
  registeredName String?
  mobile2        String?
  office1        String?
  office2        String?
  house          String?
  street         String?
  zone           String?
  tallyPartyCode String?
  mergedIntoId   String?

  // Read-only compatibility cache, derived by financial-document triggers.
  creditBalance     Float                  @default(0)
  partyStatus       String                 @default("CUSTOMER")
  partyNotes        PartyNote[]
  adjustmentBatches PartyAdjustmentBatch[]

  branchId    String
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User?  @relation("CreatedCustomers", fields: [createdById], references: [id], onDelete: SetNull)

  account           CustomerAccount?
  documents         CustomerDocument[]
  serviceHistory    ServiceHistory[]
  vehicles          Vehicle[]
  vehicleOwnerships VehicleOwnership[]
  appointments      ServiceAppointment[]
  jobCards          JobCard[]
  approvals         CustomerApproval[]
  invoices          Invoice[]
  receipts          Receipt[]
  tallyLedgerId     String?
  tallyLedger       TallyLedger?         @relation(fields: [tallyLedgerId], references: [id], onDelete: SetNull)

  creditTransactions CustomerCreditTransaction[]
  creditApplications CustomerCreditApplication[]

  warrantyCases WarrantyCase[]

  @@index([branchId])
  @@index([branchId, partyStatus, code])
  @@index([phoneNumber])
  @@index([mergedIntoId])
}

model CustomerAccount {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  passwordHash     String
  isActive         Boolean   @default(true)
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens CustomerRefreshToken[]
}

model CustomerRefreshToken {
  id                String          @id @default(uuid())
  token             String          @unique
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([customerAccountId])
}

// ============================================================
// SERVICE / APPOINTMENT
// ============================================================

model Service {
  id           String  @id @default(uuid())
  name         String  @unique
  description  String?
  category     String?
  durationMins Int?
  price        Float   @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments ServiceAppointment[]
  jobCards     JobCard[]
}

model ServiceAppointment {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ReceptionistBookings", fields: [createdById], references: [id], onDelete: SetNull)

  scheduledAt  DateTime
  durationMins Int?
  notes        String?

  status String @default("Pending")
  source String @default("WalkIn")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCards JobCard[]
  enquiry  Enquiry?

  campaignVehicles CampaignVehicle[]

  @@index([serviceId])
  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
}

// ============================================================
// JOB CARD
// ============================================================

model JobCard {
  id String @id @default(uuid())

  appointmentId String?
  appointment   ServiceAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  serviceTypeId      String?
  serviceType        WorkshopMaster?        @relation("JobServiceType", fields: [serviceTypeId], references: [id], onDelete: Restrict)
  bayId              String?
  bay                WorkshopMaster?        @relation("JobBay", fields: [bayId], references: [id], onDelete: Restrict)
  teamId             String?
  team               WorkshopMaster?        @relation("JobTeam", fields: [teamId], references: [id], onDelete: Restrict)
  serviceAdvisorId   String?
  serviceAdvisor     User?                  @relation("JobServiceAdvisor", fields: [serviceAdvisorId], references: [id], onDelete: Restrict)
  deliveryAdvisorId  String?
  deliveryAdvisor    User?                  @relation("JobDeliveryAdvisor", fields: [deliveryAdvisorId], references: [id], onDelete: Restrict)
  mileage            Int?
  promisedAt         DateTime?
  acFitted           Boolean                @default(false)
  inHouse            Boolean                @default(true)
  remarks            String?
  observations       String?
  workDone           String?
  isRepeat           Boolean                @default(false)
  previousJobId      String?
  previousJob        JobCard?               @relation("RepeatJob", fields: [previousJobId], references: [id], onDelete: Restrict)
  repeatJobs         JobCard[]              @relation("RepeatJob")
  repeatReason       String?
  readyAt            DateTime?
  deliveredAt        DateTime?
  gatePassNumber     String?                @unique
  lateReasonIds      String[]               @default([])
  creditApprovedById String?
  creditApprovedBy   User?                  @relation("JobCreditApprover", fields: [creditApprovedById], references: [id], onDelete: Restrict)
  complaints         JobComplaint[]
  statusHistory      JobCardStatusHistory[]

  jobNumber   String @unique
  description String

  status         String @default("Open")
  estimatedHours Float?
  tyres          Json?
  batteryMake    String?
  batteryNumber  String?
  customField1   String?
  acType         String?
  checklist      String?
  estimatedParts Float?
  estimatedOil   Float?
  estimatedLabour Float?
  serviceCharge  Float?
  estimatedCost  Float?

  assignedTo String?
  progress   Int?    @default(0)

  qcStatus String? @default("Pending")
  qcNotes  String?

  qualityInspectorId String?
  qualityInspector   User?   @relation("QualityInspectorAssignments", fields: [qualityInspectorId], references: [id], onDelete: SetNull)

  technicianId String?
  technician   User?   @relation("TechnicianAssignments", fields: [technicianId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("CreatedJobCards", fields: [createdById], references: [id], onDelete: SetNull)

  // Warranty snapshot taken at creation. Later policy or vehicle changes never rewrite it.
  warrantyStatusAtCreation    WarrantyCoverageStatus?
  warrantyReasonsAtCreation   String[]                @default([])
  warrantyExpiresOnAtCreation DateTime?
  warrantyKmLimitAtCreation   Int?
  warrantySnapshot            Json?
  warrantyAcknowledgedById    String?
  warrantyAcknowledgedBy      User?                   @relation("JobCardWarrantyAcknowledgedBy", fields: [warrantyAcknowledgedById], references: [id], onDelete: SetNull)
  warrantyAcknowledgedAt      DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections   Inspection[]
  estimates     Estimate[]
  partIssuances PartIssuance[]
  invoices      Invoice[]
  labourLines   JobCardLabour[]
  billedAt      DateTime?

  indentLines BranchIndentLine[] @relation("IndentLineJobCard")

  lines                     JobCardLine[]
  campaigns                 JobCardCampaign[]
  warrantyCase              WarrantyCase?
  completedCampaignVehicles CampaignVehicle[] @relation("CampaignVehicleCompletedBy")

  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([vehicleId, createdAt])
  @@index([appointmentId])
  @@index([createdAt, id])
  @@index([branchId, createdAt, id])
  @@index([branchId, status, createdAt, id])
  @@index([customerId, createdAt, id])
}

// ============================================================
// INSPECTION
// ============================================================

model Inspection {
  id String @id @default(uuid())

  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  inspectorId String?

  findings String
  passed   Boolean?
  status   String   @default("Pending")
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobCardId])
}

// ============================================================
// ESTIMATE / APPROVAL
// ============================================================

model Estimate {
  id String @id @default(uuid())

  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  description String
  amount      Float
  currency    String @default("USD")
  status      String @default("Pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     EstimateLine[]
  approvals CustomerApproval[]

  @@index([jobCardId])
}

model CustomerApproval {
  id String @id @default(uuid())

  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  approved     Boolean?
  decisionDate DateTime?
  comments     String?
  status       String    @default("Pending")

  createdAt DateTime @default(now())

  @@index([estimateId])
  @@index([customerId])
}

// ============================================================
// VEHICLE
// ============================================================

model Vehicle {
  modelId             String?
  catalogModel        VehicleCatalogModel? @relation(fields: [modelId], references: [id], onDelete: Restrict)
  generationId        String?
  catalogGeneration   VehicleCatalogGeneration? @relation(fields: [generationId], references: [id], onDelete: Restrict)
  engineId            String?
  catalogEngine       VehicleCatalogEngine? @relation(fields: [engineId], references: [id], onDelete: Restrict)
  customMake          String?
  customModel         String?
  id String @id @default(uuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  vin                String  @unique
  registrationNumber String? @unique

  catalogueId         String?
  catalogue           WorkshopMaster? @relation("VehicleCatalogue", fields: [catalogueId], references: [id], onDelete: Restrict)
  colourId            String?
  colour              WorkshopMaster? @relation("VehicleColour", fields: [colourId], references: [id], onDelete: Restrict)
  engineNumber        String?
  keyNumber           String?
  pdiDone             Boolean         @default(false)
  pdiDate             DateTime?
  saleDate            DateTime?
  sellingDealer       String?
  lastRecordedMileage Int?
  make                String?
  model               String?
  year                Int?
  trim                String?
  color               String?

  // Deprecated free-text warranty fields. No longer read or written by the app:
  // coverage is calculated (see modules/warranty). Kept until a follow-up
  // migration drops them, because migrations here are additive only.
  warrantyProvider  String?
  warrantyStatus    String?
  warrantyExpiresAt DateTime?

  // Warranty policy comes from the vehicle model.
  vehicleModelId String?
  vehicleModel   VehicleModel? @relation(fields: [vehicleModelId], references: [id], onDelete: SetNull)

  // Deprecated: superseded by saleDate (the warranty runs from the sale date).
  // Kept because migrations are additive; the reconcile migration copies it into saleDate.
  warrantyStartDate   DateTime?
  // When lastRecordedMileage was last updated. lastRecordedMileage only ever increases
  // (except an audited odometer replacement).
  lastMileageAt       DateTime?

  // Extended warranty or goodwill that replaces the model policy limits.
  warrantyOverrideType   WarrantyOverrideType?
  warrantyOverrideUntil  DateTime?
  warrantyOverrideKm     Int?
  warrantyOverrideReason String?

  ownershipStatus String?

  createdById String?
  createdBy   User?   @relation("CreatedVehicles", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images           VehicleImage[]
  ownerships       VehicleOwnership[]
  appointments     ServiceAppointment[]
  jobCards         JobCard[]
  warrantyCases    WarrantyCase[]
  campaignVehicles CampaignVehicle[]

  @@index([customerId])
  @@index([modelId])
  @@index([generationId])
  @@index([engineId])

  @@index([vehicleModelId])
}

model VehicleImage {
  id String @id @default(uuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url      String
  type     String?
  metadata Json?

  uploadedAt DateTime @default(now())

  @@index([vehicleId])
}

// ============================================================
enum PartStatus {
  ACTIVE
  BLOCKED
}

enum PartRole {
  MAIN
  ALTERNATE
}

// SPARE PART MASTER
// ============================================================

model SparePart {
  id String @id @default(uuid())

  partCode    String  @unique @default(uuid())
  partNumber  String  @unique
  name        String
  // `unitPrice` is the legacy column name; it maps to Part Master `unitRate`.
  description String?
  category    String?

  uom         String  @default("UNIT")
  taxCategory String?
  taxForm     String?
  minLevel    Float?
  maxLevel    Float?
  reorderQty  Float?

  unitPrice         Float         @default(0)
  // Legacy dealer rate is unitPrice; retail rate is the selling price.
  retailRate        Float?
  // Legacy tax status (partmast.taxable).
  taxable           Boolean       @default(true)
  // Legacy part flag, for example O for original.
  partFlag          String        @default("O")
  // Legacy pricing category (A, C, E…). Its multiplier derives the retail rate.
  priceCategoryCode String?
  priceCategory     PartCategory? @relation(fields: [priceCategoryCode], references: [code], onDelete: SetNull)

  binLocation   String?
  storeLocation String?
  partStatus    PartStatus @default(ACTIVE)

  // Legacy partmast.WTYAPPLICABLE / warrrate: only these parts can be claimed under warranty.
  warrantyApplicable Boolean @default(false)
  warrantyRate       Float?

  // --- new: main/alternate relationship ---
  role           PartRole    @default(MAIN)
  mainPartId     String?
  mainPart       SparePart?  @relation("PartAlternates", fields: [mainPartId], references: [id], onDelete: Restrict)
  alternateParts SparePart[] @relation("PartAlternates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseRequests  PurchaseRequest[]
  issuances         PartIssuance[]
  inventoryStocks   InventoryStock[]
  stockTransactions StockTransaction[]
  transferItems     InterBranchTransferItem[]
  invoiceLines      InvoiceLine[]

  indentLines      BranchIndentLine[]      @relation("IndentLinePart")
  pickingRequested PickingListLine[]       @relation("PickingRequestedPart")
  pickingSupplied  PickingListLine[]       @relation("PickingSuppliedPart")
  stnRequested     StockTransferNoteLine[] @relation("StnRequestedPart")
  stnSupplied      StockTransferNoteLine[] @relation("StnSuppliedPart")
  mitLines         MaterialInTransitLine[] @relation("MitLinePart")
  mrnLines         MaterialReceiptLine[]   @relation("MrnLinePart")

  jobCardLines      JobCardLine[]
  warrantyCaseLines WarrantyCaseLine[]

  @@index([mainPartId])
}

// ============================================================
// BRANCH INVENTORY
// ============================================================

model InventoryStock {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  partId String
  part   SparePart @relation(fields: [partId], references: [id], onDelete: Cascade)

  quantity         Int @default(0)
  reservedQuantity Int @default(0)

  minimumStock Int  @default(0)
  maximumStock Int?

  rackLocation String?
  // Legacy bin card reference per store location (PARTBAL.bincard).
  binCard      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, partId])
  @@index([partId])
  @@index([branchId])
}

// ============================================================
// STOCK TRANSACTION / AUDIT TRAIL
// ============================================================

model StockTransaction {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  partId String
  part   SparePart @relation(fields: [partId], references: [id], onDelete: Restrict)

  type String
  // RECEIVED
  // ISSUED
  // ADJUSTMENT
  // TRANSFER_IN
  // TRANSFER_OUT
  // RESERVED
  // UNRESERVED
  // RETURNED

  quantity Int

  referenceId String?
  notes       String?

  recordedById String?
  recordedBy   User?   @relation("UserStockTransactions", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([partId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
}

// ============================================================
// INTER-BRANCH TRANSFER
// ============================================================

model InterBranchTransfer {
  id String @id @default(uuid())

  transferNumber String @unique

  requestingBranchId String
  requestingBranch   Branch @relation("RequestingBranch", fields: [requestingBranchId], references: [id], onDelete: Restrict)

  sourceBranchId String
  sourceBranch   Branch @relation("SourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)

  requestedById String
  requestedBy   User   @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User?   @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  dispatchedById String?
  dispatchedBy   User?   @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)

  receivedById String?
  receivedBy   User?   @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  status String @default("Pending")
  // Pending
  // Approved
  // Rejected
  // Dispatched
  // InTransit
  // Received
  // Completed
  // Cancelled

  notes String?

  approvedAt   DateTime?
  dispatchedAt DateTime?
  receivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InterBranchTransferItem[]

  @@index([requestingBranchId])
  @@index([sourceBranchId])
  @@index([requestedById])
  @@index([status])
}

// ============================================================
// TRANSFER ITEMS
// ============================================================

model InterBranchTransferItem {
  id String @id @default(uuid())

  transferId String
  transfer   InterBranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  partId String
  part   SparePart @relation(fields: [partId], references: [id], onDelete: Restrict)

  requestedQuantity  Int
  dispatchedQuantity Int?
  receivedQuantity   Int?

  createdAt DateTime @default(now())

  @@index([transferId])
  @@index([partId])
}

// ============================================================
// PURCHASE REQUEST
// ============================================================

model PurchaseRequest {
  id String @id @default(uuid())

  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  requestedById String
  requestedBy   User   @relation("UserPurchaseRequests", fields: [requestedById], references: [id], onDelete: Restrict)

  quantity Int

  status String @default("Pending")

  requestDate   DateTime @default(now())
  approvalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sparePartId])
  @@index([requestedById])
  @@index([status])
}

// ============================================================
// PART ISSUANCE
// ============================================================

model PartIssuance {
  id String @id @default(uuid())

  // The branch whose inventory is being reduced
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  // The job card the part is being issued for
  jobCardId String?
  jobCard   JobCard? @relation(fields: [jobCardId], references: [id], onDelete: SetNull)

  issuedById String
  issuedBy   User   @relation("UserPartIssuances", fields: [issuedById], references: [id], onDelete: Restrict)

  quantity Int

  issuedAt DateTime @default(now())

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  returns PartReturn[]

  jobCardLine JobCardLine?

  @@index([branchId])
  @@index([sparePartId])
  @@index([jobCardId])
  @@index([issuedById])
  @@index([issuedAt])
}

// ============================================================
// PART RETURN
// ============================================================

model PartReturn {
  id String @id @default(uuid())

  partIssuanceId String
  partIssuance   PartIssuance @relation(fields: [partIssuanceId], references: [id], onDelete: Restrict)

  returnedById String
  returnedBy   User   @relation("UserPartReturns", fields: [returnedById], references: [id], onDelete: Restrict)

  quantity Int

  reason String?

  returnedAt DateTime @default(now())

  status String @default("Pending")
  // Pending
  // Approved
  // Rejected
  // Completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partIssuanceId])
  @@index([returnedById])
  @@index([status])
}

// ============================================================
// VEHICLE OWNERSHIP
// ============================================================

model VehicleOwnership {
  id String @id @default(uuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  ownershipType String?

  purchaseDate DateTime
  saleDate     DateTime?

  status String?

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([customerId])
}

// ============================================================
// CUSTOMER DOCUMENT
// ============================================================

model CustomerDocument {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type String
  url  String

  metadata Json?

  uploadedAt DateTime @default(now())

  @@index([customerId])
}

// ============================================================
// SERVICE HISTORY
// ============================================================

model ServiceHistory {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  serviceDate DateTime
  description String
  vehicleInfo String?
  status      String
  amount      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  serviceTotal Float @default(0)
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  jobCardId String?
  jobCard   JobCard? @relation(fields: [jobCardId], references: [id], onDelete: SetNull)

  invoiceNumber String @unique
  reportBranchId String?

  issuedDate DateTime  @default(now())
  dueDate    DateTime?

  subtotal Float
  tax      Float @default(0)
  total    Float

  partsTotal            Float @default(0)
  labourTotal           Float @default(0)
  partsDiscountPercent  Float @default(0)
  labourDiscountPercent Float @default(0)
  partsDiscountAmount   Float @default(0)
  labourDiscountAmount  Float @default(0)
  vatRate               Float @default(7.5)
  vatAmount             Float @default(0)
  roundOff              Float @default(0)
  outstandingAmount     Float @default(0)

  serviceAdvisorId String?
  serviceAdvisor   User?   @relation("InvoiceServiceAdvisor", fields: [serviceAdvisorId], references: [id], onDelete: SetNull)

  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelRemark  String?

  tallyVoucherNo  String?
  tallyPostedAt   DateTime?
  tallyPostedById String?
  tallyPostedBy   User?     @relation("InvoiceTallyPostedBy", fields: [tallyPostedById], references: [id], onDelete: SetNull)

  status String @default("Unpaid")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments    Payment[]
  receipts    Receipt[]
  lines       InvoiceLine[]
  allocations ReceiptAllocation[]

  creditApplications CustomerCreditApplication[]


  @@index([customerId])
  @@index([jobCardId])
  @@index([customerId, issuedDate])
  @@index([reportBranchId, issuedDate])
}

model LabourItem {
  id           String   @id @default(uuid())
  code         String   @unique
  description  String
  defaultHours Float    @default(1)
  rate         Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicleSystem String?
  group         String?
  modelRates    LabourRate[]
  jobCardLines  JobCardLabour[]
}

model JobCardLabour {
  id           String     @id @default(uuid())
  jobCardId    String
  jobCard      JobCard    @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  labourItemId String
  labourItem   LabourItem @relation(fields: [labourItemId], references: [id], onDelete: Restrict)
  description  String
  hours        Float
  rate         Float
  amount       Float
  technicianId String?
  technician   User?      @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  invoiceLines InvoiceLine[]

  // Who pays for this labour line (warranty / goodwill / free / customer).
  chargeLine JobCardLine?

  @@index([jobCardId])
  @@index([labourItemId])
}

model InvoiceLine {
  id              String         @id @default(uuid())
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type            String
  partId          String?
  part            SparePart?     @relation(fields: [partId], references: [id], onDelete: Restrict)
  jobCardLabourId String?
  jobCardLabour   JobCardLabour? @relation(fields: [jobCardLabourId], references: [id], onDelete: Restrict)
  description     String
  quantity        Float
  rate            Float
  amount          Float
  customerPaid    Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@index([invoiceId])
}

model DocumentSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  recordedById String?
  recordedBy   User?   @relation("UserRecordedPayments", fields: [recordedById], references: [id], onDelete: SetNull)

  amount Float
  method String

  paymentDate DateTime @default(now())

  reference String?
  notes     String?

  receiptId String?
  receipt   Receipt? @relation("PaymentReceiptLink", fields: [receiptId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([recordedById])
}

// ============================================================
// RECEIPT
// ============================================================

model Receipt {
  id String @id @default(uuid())
  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  idempotencyKey String? @unique
  requestHash String?

  receiptNumber String   @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  issuedById String?
  issuedBy   User?   @relation("UserIssuedReceipts", fields: [issuedById], references: [id], onDelete: Restrict)

  amount Float

  mode          String    @default("BANK_TRANSFER")
  category      String    @default("SERVICE_PARTS")
  bankId        String?
  bank          Bank?     @relation(fields: [bankId], references: [id], onDelete: Restrict)
  chequeNumber  String?
  chequeDate    DateTime?
  advanceAmount Float     @default(0)
  status        String    @default("ACTIVE")
  cancelRemark  String?
  cancelledAt   DateTime?

  tallyVoucherNo  String?
  tallyPostedAt   DateTime?
  tallyPostedById String?
  tallyPostedBy   User?     @relation("ReceiptTallyPostedBy", fields: [tallyPostedById], references: [id], onDelete: SetNull)

  issuedAt DateTime @default(now())

  reference String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  debitNoteLines PartyNoteReceiptLine[]
  allocations ReceiptAllocation[]
  editLogs    ReceiptEditLog[]
  payments    Payment[]           @relation("PaymentReceiptLink")

  @@index([invoiceId])
  @@index([customerId, issuedAt])
  @@index([branchId, issuedAt])
  @@index([issuedById])
}

model Bank {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  accountNumber String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receipts Receipt[]
}

model ReceiptAllocation {
  id           String                @id @default(uuid())
  receiptId    String?
  receipt      Receipt?              @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  invoiceId    String?
  invoice      Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  debitNoteId  String?
  debitNote    PartyNote?            @relation("DebitNoteAdjustments", fields: [debitNoteId], references: [id], onDelete: Restrict)
  creditNoteId String?
  creditNote   PartyNote?            @relation("CreditNoteAdjustments", fields: [creditNoteId], references: [id], onDelete: Restrict)
  batchId      String?
  batch        PartyAdjustmentBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  amount       Float
  adjustedAt   DateTime              @default(now())
  reversedAt   DateTime?
  createdAt    DateTime              @default(now())

  @@index([invoiceId])
  @@index([invoiceId, adjustedAt])
  @@index([receiptId, adjustedAt])
  @@index([debitNoteId, adjustedAt])
  @@index([creditNoteId, adjustedAt])
  @@index([batchId])
  @@index([adjustedAt, reversedAt])
}

model PartyNote {
  id                String              @id @default(uuid())
  number            String
  customerId        String
  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId          String
  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  direction         String
  type              String              @default("OPENING")
  date              DateTime
  narration         String
  amount            Decimal             @db.Decimal(18, 2)
  remainingAmount   Decimal             @db.Decimal(18, 2)
  status            String              @default("ACTIVE")
  cancelledAt       DateTime?
  tallyVoucherNo    String?
  tallyPostedAt     DateTime?
  tallyExcluded     Boolean             @default(true)
  createdById       String?
  createdBy         User?               @relation("PartyNoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  idempotencyKey    String?             @unique
  requestHash       String?
  legacyKey         String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cancelRemark String?
  partyCode String?
  partyName String?
  partyAddress String?
  partyCity String?
  partyState String?
  receiptLines PartyNoteReceiptLine[]
  accountLines PartyNoteAccountLine[]
  debitAdjustments  ReceiptAllocation[] @relation("DebitNoteAdjustments")
  creditAdjustments ReceiptAllocation[] @relation("CreditNoteAdjustments")

  @@index([branchId, direction, date])
  @@unique([direction, number])
  @@index([customerId, direction, date])
  @@index([branchId, status, date])
}

model PartyAdjustmentBatch {
  id              String                     @id @default(uuid())
  customerId      String
  customer        Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId        String
  branch          Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  date            DateTime
  source          String
  amount          Decimal                    @db.Decimal(18, 2)
  actorId         String?
  actor           User?                      @relation("PartyAdjustmentActor", fields: [actorId], references: [id], onDelete: SetNull)
  idempotencyKey  String                     @unique
  requestHash     String
  tallyPostedAt   DateTime?
  reversedAt      DateTime?
  reversedById    String?
  reversedBy      User?                      @relation("PartyAdjustmentReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  reverseRemark   String?
  legacyPaymentId String?                    @unique
  createdAt       DateTime                   @default(now())
  allocations     ReceiptAllocation[]
  application     CustomerCreditApplication?

  @@index([customerId, date])
  @@index([branchId, date])
}


model ReceiptEditLog {
  id           String   @id @default(uuid())
  receiptId    String
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  editedById   String
  editedBy     User     @relation(fields: [editedById], references: [id], onDelete: Restrict)
  oldAmount    Float
  newAmount    Float
  oldNarration String?
  newNarration String?
  createdAt    DateTime @default(now())

  @@index([receiptId, createdAt])
}

model TallyLedger {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  active     Boolean  @default(true)
  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customers Customer[]
  noteAccountLines PartyNoteAccountLine[]
}

model TallyAccountMapping {
  id              String   @id @default(uuid())
  documentType    String
  accountType     String
  tallyLedgerCode String
  tallyLedgerName String
  updatedAt       DateTime @updatedAt

  @@unique([documentType, accountType])
}

model TallyPostingLog {
  id            String    @id @default(uuid())
  documentType  String
  documentId    String
  status        String    @default("EXPORTED")
  voucherNumber String?
  batchId       String
  payload       String?
  postedAt      DateTime?
  postedById    String?
  postedBy      User?     @relation("TallyPostingUser", fields: [postedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@unique([documentType, documentId])
  @@index([batchId])
  @@index([status, createdAt])
}

// ============================================================
// CUSTOMER CREDIT
// ============================================================

model CustomerCreditTransaction {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  amount       Float
  balanceAfter Float

  type String
  // CREDIT_IN
  // ADJUSTMENT
  // USED

  description String?
  referenceId String?

  recordedById String?
  recordedBy   User?   @relation("UserCreditTransactions", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([referenceId])
}

model CustomerCreditApplication {
  batchId String?               @unique
  batch   PartyAdjustmentBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Float

  status String @default("Pending")
  // Pending
  // Approved
  // Declined

  comments     String?
  decisionDate DateTime?

  requestedById String
  requestedBy   User   @relation("AdvisorCreditRequests", fields: [requestedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status])
  @@index([invoiceId])
  @@index([requestedById])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  title   String
  message String
  link    String?

  readAt DateTime?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([branchId, readAt])
}

// ============================================================
// ENQUIRY
// ============================================================

model Enquiry {
  id String @id @default(uuid())

  firstName String
  lastName  String

  email       String
  phoneNumber String

  vehicleMake      String?
  vehicleModel     String?
  vehicleYear      Int?
  vehicleRegNumber String?

  serviceDescription String

  preferredDate DateTime?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  status String @default("Pending")
  // Pending
  // Approved
  // Rejected
  // Converted

  appointmentId String?             @unique
  appointment   ServiceAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  reviewedById String?
  reviewedBy   User?   @relation("EnquiryReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewNotes String?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([email])
}

// Typed master families share search, activation and legacy-code handling.
model WorkshopMaster {
  id               String           @id @default(uuid())
  kind             String
  code             String
  description      String
  active           Boolean          @default(true)
  category         String?
  chargedTo        String           @default("CUSTOMER")
  freeService      Boolean          @default(false)
  displayOrder     Int?
  preDelivery      Boolean          @default(false)
  parentId         String?
  parent           WorkshopMaster?  @relation("MasterHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         WorkshopMaster[] @relation("MasterHierarchy")
  fuel             String?
  gearbox          String?
  acFitted         Boolean          @default(false)
  warrantyDays     Int?
  warrantyKm       Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  serviceJobs      JobCard[]        @relation("JobServiceType")
  bayJobs          JobCard[]        @relation("JobBay")
  teamJobs         JobCard[]        @relation("JobTeam")
  complaints       JobComplaint[]
  vehicles         Vehicle[]        @relation("VehicleCatalogue")
  colouredVehicles Vehicle[]        @relation("VehicleColour")
  labourRates      LabourRate[]
  serviceTypeSettings ServiceTypeModelSetting[] @relation("ServiceTypeSettings")
  modelServiceSettings ServiceTypeModelSetting[] @relation("ModelServiceSettings")

  @@unique([kind, code])
  @@index([kind, active])
  @@index([parentId])
}

model ServiceTypeModelSetting {
  id             String         @id @default(uuid())
  serviceTypeId  String
  serviceType    WorkshopMaster @relation("ServiceTypeSettings", fields: [serviceTypeId], references: [id], onDelete: Restrict)
  modelId        String
  model          WorkshopMaster @relation("ModelServiceSettings", fields: [modelId], references: [id], onDelete: Restrict)
  serviceCharge  Float
  previousCharge Float?
  effectiveFrom  DateTime?
  active         Boolean        @default(true)

  @@unique([serviceTypeId, modelId])
  @@index([modelId, active, serviceTypeId])
}

model JobComplaint {
  id              String          @id @default(uuid())
  jobCardId       String
  jobCard         JobCard         @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  complaintCodeId String?
  complaintCode   WorkshopMaster? @relation(fields: [complaintCodeId], references: [id], onDelete: Restrict)
  description     String
  defectCode      String?
  spare           Float           @default(0)
  oil             Float           @default(0)
  labour          Float           @default(0)

  @@index([jobCardId])
}

model JobCardStatusHistory {
  id         String   @id @default(uuid())
  jobCardId  String
  jobCard    JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  remarks    String?
  createdAt  DateTime @default(now())

  @@index([jobCardId, createdAt])
}

model LabourRate {
  id           String         @id @default(uuid())
  labourItemId String
  labourItem   LabourItem     @relation(fields: [labourItemId], references: [id], onDelete: Restrict)
  modelId      String
  model        WorkshopMaster @relation(fields: [modelId], references: [id], onDelete: Restrict)
  pricing      String         @default("TIME")
  hours        Float          @default(1)
  rate         Float
  active       Boolean        @default(true)

  @@unique([labourItemId, modelId])
}

model EstimateLine {
  id          String   @id @default(uuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  type        String
  referenceId String?
  description String
  quantity    Float    @default(1)
  rate        Float    @default(0)
  amount      Float    @default(0)

  @@index([estimateId])
}

model VehicleCatalogMake {
  id     String               @id @default(uuid())
  name   String               @unique
  models VehicleCatalogModel[]
}

model VehicleCatalogModel {
  id          String                    @id @default(uuid())
  makeId      String
  make        VehicleCatalogMake        @relation(fields: [makeId], references: [id], onDelete: Restrict)
  name        String
  searchName  String
  aliases     String[]
  yearStart   Int
  yearEnd     Int?
  generations VehicleCatalogGeneration[]
  vehicles    Vehicle[]

  @@unique([makeId, name])
  @@index([makeId, searchName])
}

model VehicleCatalogGeneration {
  id            String                 @id @default(uuid())
  modelId       String
  model         VehicleCatalogModel    @relation(fields: [modelId], references: [id], onDelete: Restrict)
  name          String
  yearStart     Int
  yearEnd       Int?
  bodyType      String?
  sourceOrdinal Int                    @default(0)
  engines       VehicleCatalogEngine[]
  vehicles      Vehicle[]

  @@unique([modelId, name, yearStart, sourceOrdinal])
  @@index([modelId])
}

model VehicleCatalogEngine {
  id                    String                  @id @default(uuid())
  generationId          String
  generation            VehicleCatalogGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  label                 String
  sourceOrdinal         Int                     @default(0)
  fuelType              String?
  cylinders             Int?
  displacementCc        Int?
  powerHp               Float?
  torqueNm              Float?
  transmission          String?
  drivetrain            String?
  zeroToHundredKmhS      Float?
  topSpeedKmh           Float?
  fuelEconomyCombinedL100 Float?
  lengthMm              Int?
  widthMm               Int?
  heightMm              Int?
  wheelbaseMm           Int?
  curbWeightKg          Int?
  specs                 Json
  vehicles              Vehicle[]

  @@unique([generationId, label, sourceOrdinal])
  @@index([generationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Stock transfer workflow (issue #62, Process A)
//
// Branch Indent → Picking List → STN → Cases + Packing List → MIT → SRN
//
// Only four user actions drive the flow: create/submit the indent, approve it,
// dispatch it and receive it. Every intermediate document is generated by the
// system from data already captured, so nothing is typed in twice.
// Document numbers follow the legacy format YYYY + 6-digit sequence
// (e.g. 2026000132), so migrated legacy numbers fit the same columns.
// ─────────────────────────────────────────────────────────────────────────────

enum IndentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PICKING
  PICKED
  STN_CREATED
  PACKED
  DISPATCHED
  IN_TRANSIT
  MRN_CREATED
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PickingListStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum StnStatus {
  CREATED
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum TransferCaseStatus {
  PACKED
  DISPATCHED
  RECEIVED
}

enum PackingListStatus {
  PACKED
  DISPATCHED
}

enum TransportMode {
  ROAD
  AIR
  SEA
  COURIER
  HAND_DELIVERY
  DOOR_DELIVERY
}

enum MobisOrderMode {
  AIR
  COURIER
}

// Legacy pricing categories (Category table): retail rate = dealer rate × markupMultiplier.
model PartCategory {
  code             String   @id
  description      String
  markupMultiplier Float    @default(1)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  parts SparePart[]
}

enum MitStatus {
  IN_TRANSIT
  VERIFIED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// Where the stock on an MRN came from: a Mobis invoice (MIT) or a branch transfer (STN).
enum MrnSource {
  MOBIS
  BRANCH_TRANSFER
}

model BranchIndent {
  id           String @id @default(uuid())
  indentNumber String @unique

  requestingBranchId String
  requestingBranch   Branch @relation("IndentRequestingBranch", fields: [requestingBranchId], references: [id], onDelete: Restrict)

  sourceBranchId String
  sourceBranch   Branch @relation("IndentSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)

  status    IndentStatus @default(DRAFT)
  orderDate DateTime     @default(now())
  remarks   String?

  // Requesting-branch authorisation (legacy AuthorisedBy / ApprovalDate, e.g. "SM").
  authorisedBy String?
  authorisedAt DateTime?

  requestedById String
  requestedBy   User   @relation("IndentRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  submittedAt DateTime?

  approvedById    String?
  approvedBy      User?     @relation("IndentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  approvalRemarks String?

  rejectedById    String?
  rejectedBy      User?     @relation("IndentRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt      DateTime?
  rejectionReason String?

  cancelledById      String?
  cancelledBy        User?     @relation("IndentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancellationReason String?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         BranchIndentLine[]
  statusHistory TransferStatusHistory[]
  pickingList   PickingList?
  stn           StockTransferNote?

  @@index([requestingBranchId])
  @@index([sourceBranchId])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
}

model BranchIndentLine {
  id         String       @id @default(uuid())
  indentId   String
  indent     BranchIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  lineNumber Int

  partId String
  part   SparePart @relation("IndentLinePart", fields: [partId], references: [id], onDelete: Restrict)

  // Legacy part flag, for example O for original.
  partFlag String?

  // Legacy XLS: "Urgent required for Vehicle", "Urgent required for Stock",
  // and "Stock Order (15 days consumption)".
  urgentQuantity     Int @default(0)
  stockQuantity      Int @default(0)
  stockOrderQuantity Int @default(0)
  requestedQuantity  Int

  approvedQuantity  Int?
  backOrderQuantity Int  @default(0)

  // Snapshots taken from Part Master and branch stock when the line is created.
  unitRate     Float
  amount       Float
  currentStock Int?

  // Urgent vehicle order context (legacy Jobno, JobDate, VIN, Registrationno, Model).
  jobCardId          String?
  jobCard            JobCard?  @relation("IndentLineJobCard", fields: [jobCardId], references: [id], onDelete: SetNull)
  jobNumber          String?
  jobDate            DateTime?
  vin                String?
  registrationNumber String?
  vehicleModel       String?

  // How an urgent part should be ordered from Mobis if it is not available (authorised by the SM).
  mobisOrderMode MobisOrderMode?

  remarks String?

  createdAt DateTime @default(now())

  pickingLines PickingListLine[]
  stnLines     StockTransferNoteLine[]

  @@unique([indentId, lineNumber])
  @@index([partId])
  @@index([jobCardId])
}

model TransferStatusHistory {
  id       String       @id @default(uuid())
  indentId String
  indent   BranchIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  fromStatus IndentStatus?
  toStatus   IndentStatus

  actorId String?
  actor   User?   @relation("TransferStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  remarks   String?
  createdAt DateTime @default(now())

  @@index([indentId, createdAt])
}

model PickingList {
  id            String @id @default(uuid())
  pickingNumber String @unique

  indentId String       @unique
  indent   BranchIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation("PickingListBranch", fields: [branchId], references: [id], onDelete: Restrict)

  status PickingListStatus @default(OPEN)

  createdById   String?
  createdBy     User?     @relation("PickingListCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedById String?
  completedBy   User?     @relation("PickingListCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PickingListLine[]
  stn   StockTransferNote?

  @@index([branchId])
  @@index([status])
}

model PickingListLine {
  id            String      @id @default(uuid())
  pickingListId String
  pickingList   PickingList @relation(fields: [pickingListId], references: [id], onDelete: Cascade)

  indentLineId String
  indentLine   BranchIndentLine @relation(fields: [indentLineId], references: [id], onDelete: Cascade)

  // The part originally requested and the part actually supplied (alternate traceability).
  requestedPartId String
  requestedPart   SparePart @relation("PickingRequestedPart", fields: [requestedPartId], references: [id], onDelete: Restrict)
  partId          String
  part            SparePart @relation("PickingSuppliedPart", fields: [partId], references: [id], onDelete: Restrict)
  isAlternate     Boolean   @default(false)

  // Source stock available when picked, and the quantity reserved for this line.
  availableQuantity Int
  pickedQuantity    Int
  binLocation       String?

  createdAt DateTime @default(now())

  stnLine StockTransferNoteLine?

  @@unique([pickingListId, indentLineId])
  @@index([partId])
}

model StockTransferNote {
  id        String @id @default(uuid())
  stnNumber String @unique

  indentId String       @unique
  indent   BranchIndent @relation(fields: [indentId], references: [id], onDelete: Restrict)

  pickingListId String      @unique
  pickingList   PickingList @relation(fields: [pickingListId], references: [id], onDelete: Restrict)

  sourceBranchId String
  sourceBranch   Branch @relation("StnSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)

  destinationBranchId String
  destinationBranch   Branch @relation("StnDestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)

  status        StnStatus      @default(CREATED)
  documentDate  DateTime       @default(now())
  taxForm       String?
  transportMode TransportMode?
  remarks       String?

  // Guards the single stock deduction for this STN.
  stockDeducted Boolean @default(false)
  totalQuantity Int     @default(0)
  totalValue    Float   @default(0)

  createdById    String?
  createdBy      User?     @relation("StnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  dispatchedById String?
  dispatchedBy   User?     @relation("StnDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  dispatchedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines       StockTransferNoteLine[]
  cases       TransferCase[]
  packingList PackingList?
  // Goods received notes raised by the receiving branch; more than one when received in parts.
  mrns        MaterialReceiptNote[]

  @@index([sourceBranchId])
  @@index([destinationBranchId])
  @@index([status])
}

model StockTransferNoteLine {
  id    String            @id @default(uuid())
  stnId String
  stn   StockTransferNote @relation(fields: [stnId], references: [id], onDelete: Cascade)

  indentLineId  String
  indentLine    BranchIndentLine @relation(fields: [indentLineId], references: [id], onDelete: Restrict)
  pickingLineId String           @unique
  pickingLine   PickingListLine  @relation(fields: [pickingLineId], references: [id], onDelete: Restrict)

  requestedPartId String
  requestedPart   SparePart @relation("StnRequestedPart", fields: [requestedPartId], references: [id], onDelete: Restrict)
  partId          String
  part            SparePart @relation("StnSuppliedPart", fields: [partId], references: [id], onDelete: Restrict)
  isAlternate     Boolean   @default(false)

  quantity Int
  unitRate Float
  amount   Float

  // Running receipt tallies, updated by each MRN the receiving branch posts against this line.
  receivedQuantity Int @default(0)
  damagedQuantity  Int @default(0)
  shortQuantity    Int @default(0)

  createdAt DateTime @default(now())

  caseLines TransferCaseLine[]
  mrnLines  MaterialReceiptLine[]

  @@index([stnId])
  @@index([partId])
}

model TransferCase {
  id         String @id @default(uuid())
  caseNumber String @unique

  stnId String
  stn   StockTransferNote @relation(fields: [stnId], references: [id], onDelete: Cascade)

  packingListId String?
  packingList   PackingList? @relation(fields: [packingListId], references: [id], onDelete: SetNull)

  branchId String
  branch   Branch @relation("TransferCaseBranch", fields: [branchId], references: [id], onDelete: Restrict)

  status        TransferCaseStatus @default(PACKED)
  packerName    String?
  weight        Float?
  totalQuantity Int                @default(0)

  createdById String?
  createdBy   User?   @relation("TransferCaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines TransferCaseLine[]

  @@index([stnId])
  @@index([packingListId])
}

model TransferCaseLine {
  id     String       @id @default(uuid())
  caseId String
  case   TransferCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  stnLineId String
  stnLine   StockTransferNoteLine @relation(fields: [stnLineId], references: [id], onDelete: Restrict)

  quantity Int

  @@unique([caseId, stnLineId])
  @@index([stnLineId])
}

model PackingList {
  id            String @id @default(uuid())
  packingNumber String @unique

  stnId String            @unique
  stn   StockTransferNote @relation(fields: [stnId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation("PackingListBranch", fields: [branchId], references: [id], onDelete: Restrict)

  status            PackingListStatus @default(PACKED)
  dispatchMode      TransportMode?
  waybillNumber     String?
  courierName       String?
  consignmentWeight Float?
  packingDate       DateTime          @default(now())
  dispatchedAt      DateTime?
  remarks           String?

  createdById String?
  createdBy   User?   @relation("PackingListCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases TransferCase[]

  @@index([branchId])
}

// MIT covers both internal transfers (from an STN) and, later, external
// vendor (Mobis) shipments. Vendor fields stay null for internal transfers.
// Material in transit from Mobis only: one record per imported Mobis invoice.
// Branch-to-branch transfers do not use MIT; they travel on the STN and are received with an MRN.
model MaterialInTransit {
  id        String    @id @default(uuid())
  mitNumber String    @unique
  status    MitStatus @default(IN_TRANSIT)

  destinationBranchId String
  destinationBranch   Branch @relation("MitDestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)

  // Mobis invoice fields.
  vendor              String?
  invoiceNumber       String?
  invoiceDate         DateTime?
  conversionRate      Float?
  receivedMode        TransportMode?
  // Legacy "Material phy rec date" and the imported file's name.
  physicalReceiptDate DateTime?
  sourceFileName      String?
  cancelledAt         DateTime?

  transitDate   DateTime @default(now())
  totalCases    Int      @default(0)
  totalQuantity Int      @default(0)
  totalAmount   Float    @default(0)
  remarks       String?

  createdById String?
  createdBy   User?   @relation("MitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines MaterialInTransitLine[]
  mrn   MaterialReceiptNote?

  @@index([vendor, invoiceNumber])
  @@index([status])
  @@index([destinationBranchId])
}

model MaterialInTransitLine {
  id    String            @id @default(uuid())
  mitId String
  mit   MaterialInTransit @relation(fields: [mitId], references: [id], onDelete: Cascade)

  partId String
  part   SparePart @relation("MitLinePart", fields: [partId], references: [id], onDelete: Restrict)

  caseNumbers String?
  quantity    Int
  unitPrice   Float
  amount      Float

  // Line details as printed on the Mobis invoice.
  orderNumber     String?
  lineNumber      Int?
  weight          Float?
  hsCode          String?
  orderedQuantity Int?
  intRef          String?
  filePartNumber  String?
  filePartName    String?
  // True when the part was created in Part Master from this invoice.
  newPart         Boolean @default(false)

  // Receipt tallies, set when the MRN is posted against this line.
  receivedQuantity Int @default(0)
  damagedQuantity  Int @default(0)
  shortQuantity    Int @default(0)

  createdAt DateTime @default(now())

  mrnLines MaterialReceiptLine[]

  @@index([mitId])
  @@index([partId])
}

// Material Receipt Note: receipt of externally purchased (Mobis) material into
// CPD stock. Distinct from the SRN, which receives internal transfers.
// One MRN per MIT, so stock from an invoice can only be posted once.
// Material receipt note: posts received stock to the receiving branch.
// A Mobis MRN closes one MIT. A branch-transfer MRN is raised by the receiving branch against
// the STN; a transfer received in parts has one MRN per receipt.
model MaterialReceiptNote {
  id        String    @id @default(uuid())
  mrnNumber String    @unique
  source    MrnSource

  // Set when source = MOBIS.
  mitId String?            @unique
  mit   MaterialInTransit? @relation(fields: [mitId], references: [id], onDelete: Restrict)

  // Set when source = BRANCH_TRANSFER.
  stnId          String?
  stn            StockTransferNote? @relation(fields: [stnId], references: [id], onDelete: Restrict)
  sourceBranchId String?
  sourceBranch   Branch?            @relation("MrnSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)

  receivingBranchId String
  receivingBranch   Branch @relation("MrnReceivingBranch", fields: [receivingBranchId], references: [id], onDelete: Restrict)

  // Mobis only.
  vendor         String?
  invoiceNumber  String?
  // Legacy tax form: P for Mobis purchases; a transfer MRN takes the STN's form, if any.
  taxForm        String?
  // Invoice currency to naira; 1 for branch transfers, which are already in naira.
  conversionRate Float    @default(1)
  receiptDate    DateTime @default(now())
  remarks        String?

  totalReceived Int   @default(0)
  totalDamaged  Int   @default(0)
  totalShort    Int   @default(0)
  // Value of accepted stock in local currency (unit price x conversion rate).
  totalValue    Float @default(0)

  receivedById String?
  receivedBy   User?   @relation("MrnReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  lines MaterialReceiptLine[]

  @@index([receivingBranchId])
  @@index([stnId])
  @@index([source])
}

model MaterialReceiptLine {
  id    String              @id @default(uuid())
  mrnId String
  mrn   MaterialReceiptNote @relation(fields: [mrnId], references: [id], onDelete: Cascade)

  // Exactly one of these is set, matching the MRN's source.
  mitLineId String?
  mitLine   MaterialInTransitLine? @relation(fields: [mitLineId], references: [id], onDelete: Restrict)
  stnLineId String?
  stnLine   StockTransferNoteLine? @relation(fields: [stnLineId], references: [id], onDelete: Restrict)

  partId String
  part   SparePart @relation("MrnLinePart", fields: [partId], references: [id], onDelete: Restrict)

  receivedQuantity Int @default(0)
  damagedQuantity  Int @default(0)
  shortQuantity    Int @default(0)

  // Unit price as sent (Mobis: invoice currency; transfer: naira) and its naira cost.
  unitPrice Float
  unitCost  Float
  amount    Float

  remarks String?

  @@index([mrnId])
  @@index([mitLineId])
  @@index([stnLineId])
}

// ============================================================
// WARRANTY, CHARGE TYPES & CAMPAIGNS
// ============================================================

enum WarrantyCoverageStatus {
  ACTIVE
  EXPIRED_DATE
  EXPIRED_MILEAGE
  NOT_COVERED
  UNKNOWN
}

enum WarrantyOverrideType {
  EXTENDED
  GOODWILL
}

// Who pays for a job card line. Legacy requisitionpartdetail.warranty: N, W, G, F.
enum ChargeType {
  CUSTOMER
  WARRANTY
  GOODWILL
  FREE
}

enum JobCardLineKind {
  PART
  LABOUR
}

enum WarrantyCaseStatus {
  OPEN
  IN_REVIEW
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  RETURNED
  SETTLED
  CLOSED
}

enum WarrantyLineRole {
  CAUSAL
  CONSEQUENTIAL
}

enum CampaignType {
  RECALL
  FREE_FIX
  SERVICE_CAMPAIGN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum CampaignVehicleStatus {
  PENDING
  CONTACTED
  SCHEDULED
  COMPLETED
  NOT_REACHABLE
  NOT_APPLICABLE
}

enum ContactChannel {
  PHONE
  SMS
  WHATSAPP
  EMAIL
  VISIT
}

enum ContactOutcome {
  REACHED
  NO_ANSWER
  WRONG_NUMBER
  CALL_BACK
  DECLINED
}

// Vehicle model master with its warranty policy (legacy `model`: warrdays, warrMileage).
model VehicleModel {
  id   String @id @default(uuid())
  code String @unique
  make String @default("Kia")
  name String

  warrantyDays    Int?
  warrantyKm      Int?
  warrantyCovered Boolean @default(true)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles  Vehicle[]
  campaigns CampaignModel[]

  @@unique([make, name])
}

// A priced part or labour line on a job card, with who pays for it.
model JobCardLine {
  id String @id @default(uuid())

  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  kind JobCardLineKind

  sparePartId String?
  sparePart   SparePart? @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  // Set for part lines created from a stock issuance (one line per issuance).
  partIssuanceId String?       @unique
  partIssuance   PartIssuance? @relation(fields: [partIssuanceId], references: [id], onDelete: SetNull)

  // Set for labour lines: the job card labour line (labour catalogue) this charge line belongs to.
  jobCardLabourId String?        @unique
  jobCardLabour   JobCardLabour? @relation(fields: [jobCardLabourId], references: [id], onDelete: Cascade)

  operationCode String?
  description   String
  // Quantity for parts, hours for labour.
  quantity      Float
  rate          Float
  amount        Float
  taxable       Boolean @default(true)

  chargeType ChargeType @default(CUSTOMER)

  // Set when the line is charged to a campaign (FREE).
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  chargeTypeChangedById String?
  chargeTypeChangedBy   User?     @relation("JobCardLineChargeChangedBy", fields: [chargeTypeChangedById], references: [id], onDelete: SetNull)
  chargeTypeChangedAt   DateTime?
  chargeTypeReason      String?

  createdById String?
  createdBy   User?   @relation("JobCardLineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warrantyCaseLines WarrantyCaseLine[]

  @@index([jobCardId])
  @@index([campaignId])
  @@index([sparePartId])
}


// ── Warranty claim codes (legacy warrcomp, warrdef, warrpos, warrrej) ──

model WarrantyComplaintCode {
