  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  amount       Float
  balanceAfter Float

  type String
  // CREDIT_IN
  // ADJUSTMENT
  // USED

  description String?
  referenceId String?

  recordedById String?
  recordedBy   User?   @relation("UserCreditTransactions", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
