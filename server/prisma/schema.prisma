model WarrantyDefectCode {
  id          String  @id @default(uuid())
  code        String  @unique
  description String
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines WarrantyCaseLine[]
}

model WarrantyPositionCode {
  id          String  @id @default(uuid())
  code        String  @unique
  description String
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

