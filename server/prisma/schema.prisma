  documentType  String
  documentId    String
  status        String    @default("EXPORTED")
  voucherNumber String?
  batchId       String
  payload       String?
  postedAt      DateTime?
  postedById    String?
  postedBy      User?     @relation("TallyPostingUser", fields: [postedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@unique([documentType, documentId])
  @@index([batchId])
  @@index([status, createdAt])
}

// ============================================================
